# ---- Core ----
NODE_ENV=production
PORT=3000
# Public URL of the portal (used in WhatsApp links and OAuth callbacks)
BASE_URL=https://academy.example.com
# Random string, 32+ characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# When false, new accounts are students; admins promote teachers from Admin → Users
ALLOW_TEACHER_SIGNUP=true
MAX_UPLOAD_MB=500

# ---- WhatsApp ----
# mock    = simulator inside the portal (no messages leave the server)
# baileys = linked WhatsApp number: creates a GROUP per student and sends native POLLS (scan QR in Admin)
# cloud   = official WhatsApp Business Cloud API: 1:1 chats, interactive buttons/lists instead of polls
WHATSAPP_PROVIDER=mock
WHATSAPP_MAX_VIDEO_MB=16
# Pause between messages (ms). Defaults to 1500 for real providers.
# WHATSAPP_SEND_DELAY_MS=1500
REMINDER_HOURS=24
MAX_REMINDERS=3

# Cloud API only
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_VERIFY_TOKEN=
WA_CLOUD_APP_SECRET=
WA_CLOUD_WELCOME_TEMPLATE=
WA_CLOUD_TEMPLATE_LANG=en

# ---- Social sign-in (leave blank to hide a provider) ----
# Redirect URIs to register:  {BASE_URL}/auth/google/callback, /auth/microsoft/callback, /auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Email (password reset) ----
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Laqtin <no-reply@example.com>
