<a href="/courses/<%= c.id %>" class="card course-card">
  <div class="cover" style="--c: <%= c.color %>">
    <span class="glyph"><%= initials(c.title) %></span>
    <span class="meta"><span><%= c.lesson_count %> lesson<%= c.lesson_count === 1 ? '' : 's' %></span><% if (c.student_count) { %><span><%= c.student_count %> learner<%= c.student_count === 1 ? '' : 's' %></span><% } %></span>
  </div>
  <div class="body">
    <h3><%= c.title %></h3>
    <p><%= c.summary || 'Video lessons with practice on WhatsApp.' %></p>
    <div class="foot">
      <span class="teacher"><span class="avatar"><%= initials(c.teacher_name) %></span><%= c.teacher_name %></span>
      <span class="row" style="gap:4px"><%- icon('whatsapp', 'wa-ico') %></span>
    </div>
  </div>
</a>
