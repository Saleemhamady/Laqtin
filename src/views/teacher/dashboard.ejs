<%- include('../partials/head') %>
<div class="container">
  <div class="page-head">
    <div><h1>Teaching</h1><p class="muted">Your courses, lessons and students.</p></div>
    <a href="/teach/courses/new" class="btn primary"><%- icon('plus') %>New course</a>
  </div>
  <% if (!courses.length) { %>
    <div class="card"><div class="empty">
      <div class="icon-ring"><%- icon('video') %></div>
      <h3>Create your first course</h3>
      <p>Add short video lessons and a few practice questions. Students get them on WhatsApp the moment they enroll.</p>
      <a href="/teach/courses/new" class="btn primary"><%- icon('plus') %>New course</a>
    </div></div>
  <% } else { %>
    <div class="card"><div class="table-wrap"><table>
      <thead><tr><th>Course</th><th>Status</th><th>Lessons</th><th>Students</th><th>Completed</th><th></th></tr></thead>
      <tbody>
        <% courses.forEach(function (c) { %>
          <tr>
            <td><a href="/teach/courses/<%= c.id %>" class="row" style="gap:12px; color:var(--ink); font-weight:550; flex-wrap:nowrap"><span class="file-ico" style="background:<%= c.color %>; color:#fff; font-size:.75rem; font-weight:650"><%= initials(c.title) %></span><%= c.title %></a></td>
            <td><span class="badge <%= c.published ? 'green' : '' %>"><%= c.published ? 'Published' : 'Draft' %></span></td>
            <td><%= c.lesson_count %></td>
            <td><%= c.student_count %></td>
            <td><%= c.completed_count %></td>
            <td style="text-align:right"><a href="/teach/courses/<%= c.id %>" class="btn secondary sm">Manage</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
