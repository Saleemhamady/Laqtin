<%- include('../partials/head') %>
<div class="container">
  <div class="page-head">
    <div>
      <div class="eyebrow"><a href="/teach">Teaching</a> <span>/</span></div>
      <h1 class="row" style="gap:12px"><%= course.title %> <span class="badge <%= course.published ? 'green' : '' %>"><%= course.published ? 'Published' : 'Draft' %></span></h1>
    </div>
    <div class="row">
      <a href="/courses/<%= course.id %>" class="btn ghost" target="_blank"><%- icon('eye') %>View</a>
      <form method="post" action="/teach/courses/<%= course.id %>/publish">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="publish" value="<%= course.published ? '0' : '1' %>">
        <button class="btn <%= course.published ? 'secondary' : 'primary' %>"><%= course.published ? 'Unpublish' : 'Publish course' %></button>
      </form>
    </div>
  </div>

  <nav class="tabs">
    <a href="?tab=content" class="<%= tab === 'content' ? 'active' : '' %>">Lessons<span class="count"><%= lessons.length %></span></a>
    <a href="?tab=students" class="<%= tab === 'students' ? 'active' : '' %>">Students<span class="count"><%= course.student_count %></span></a>
    <a href="?tab=settings" class="<%= tab === 'settings' ? 'active' : '' %>">Settings</a>
  </nav>

  <% if (tab === 'content') { %>
    <div class="card">
      <% if (!lessons.length) { %>
        <div class="empty"><div class="icon-ring"><%- icon('video') %></div><h3>No lessons yet</h3><p>Each lesson is one video plus optional materials and practice questions.</p></div>
      <% } else { %>
        <ul class="list">
          <% lessons.forEach(function (l, i) { %>
            <li>
              <span class="num"><%= i + 1 %></span>
              <div class="grow">
                <a class="title" href="/teach/lessons/<%= l.id %>"><%= l.title %></a>
                <span class="sub row" style="gap:12px">
                  <span class="row" style="gap:4px"><%- icon(l.video_file || l.video_url ? 'check' : 'alert', 'chip-check') %><%= l.video_file || l.video_url ? 'Video' : 'No video' %></span>
                  <span><%= l.question_count %> question<%= l.question_count === 1 ? '' : 's' %></span>
                  <span><%= l.material_count %> material<%= l.material_count === 1 ? '' : 's' %></span>
                </span>
              </div>
              <form method="post" action="/teach/lessons/<%= l.id %>/move" class="row" style="gap:2px">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn ghost icon" name="dir" value="up" aria-label="Move up" <%= i === 0 ? 'disabled' : '' %>><%- icon('up') %></button>
                <button class="btn ghost icon" name="dir" value="down" aria-label="Move down" <%= i === lessons.length - 1 ? 'disabled' : '' %>><%- icon('down') %></button>
              </form>
              <a href="/teach/lessons/<%= l.id %>" class="btn secondary sm"><%- icon('edit') %>Edit</a>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <form method="post" action="/teach/courses/<%= course.id %>/lessons" class="card-foot row" style="flex-wrap:nowrap">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="text" name="title" placeholder="New lesson title" required maxlength="160">
        <button class="btn primary"><%- icon('plus') %>Add lesson</button>
      </form>
    </div>
  <% } %>

  <% if (tab === 'students') { %>
    <div class="card">
      <% if (!students.length) { %>
        <div class="empty"><div class="icon-ring"><%- icon('users') %></div><h3>No students yet</h3><p><%= course.published ? 'Share the course link to get your first students.' : 'Publish the course so students can enroll.' %></p>
        <% if (course.published) { %><code class="small"><%= baseUrl %>/courses/<%= course.id %></code><% } %></div>
      <% } else { %>
        <div class="table-wrap"><table>
          <thead><tr><th>Student</th><th>WhatsApp</th><th>Progress</th><th>Score</th><th>Last activity</th><th></th></tr></thead>
          <tbody>
            <% students.forEach(function (s) { %>
              <tr>
                <td><div class="row" style="gap:10px; flex-wrap:nowrap"><span class="avatar"><%= initials(s.name) %></span><div><a href="/teach/enrollments/<%= s.id %>" style="color:var(--ink); font-weight:550"><%= s.name %></a><div class="small muted"><%= s.phone || s.email %></div></div></div></td>
                <td><span class="badge <%= s.wa_state === 'done' ? 'green' : s.wa_state === 'error' ? 'red' : s.wa_state === 'awaiting_join' ? 'amber' : 'teal' %>" title="<%= s.wa_error || '' %>"><%= WA_STATE_LABEL[s.wa_state] %></span></td>
                <td><div class="row" style="gap:10px; flex-wrap:nowrap"><div class="progress"><span style="width:<%= s.progress.pct %>%"></span></div><span class="small muted"><%= s.progress.done %>/<%= s.progress.lessons.length %></span></div></td>
                <td><%= s.progress.scorePct === null ? '—' : s.progress.scorePct + '%' %></td>
                <td class="small muted nowrap"><%= s.last_activity ? s.last_activity.slice(0, 16).replace('T', ' ') : '—' %></td>
                <td style="text-align:right"><a href="/teach/enrollments/<%= s.id %>" class="btn ghost icon" aria-label="Details"><%- icon('right') %></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
      <% } %>
    </div>
  <% } %>

  <% if (tab === 'settings') { %>
    <div class="container narrow" style="padding:0; margin:0">
      <form method="post" action="/teach/courses/<%= course.id %>" class="card">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="card-body"><%- include('course-fields') %></div>
        <div class="card-foot" style="text-align:right"><button class="btn primary">Save changes</button></div>
      </form>
      <div class="card section">
        <div class="card-body row between">
          <div><h3>Delete course</h3><p class="small muted" style="margin:0">Only possible while no students are enrolled.</p></div>
          <form method="post" action="/teach/courses/<%= course.id %>/delete" data-confirm="Delete this course and all its lessons? This can’t be undone.">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger"><%- icon('trash') %>Delete</button>
          </form>
        </div>
      </div>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
