<%- include('partials/head') %>
<div class="container">
  <div class="split">
    <div>
      <div class="eyebrow"><a href="/courses">Courses</a> <span>/</span></div>
      <h1><%= course.title %></h1>
      <% if (course.summary) { %><p class="muted" style="font-size:1.08rem"><%= course.summary %></p><% } %>
      <div class="row muted small" style="margin:18px 0 28px; gap:20px">
        <span class="teacher"><span class="avatar"><%= initials(course.teacher_name) %></span><%= course.teacher_name %></span>
        <span class="row" style="gap:6px"><%- icon('video', 'chip-check') %><%= course.lesson_count %> lessons</span>
        <span class="row" style="gap:6px"><%- icon('poll', 'chip-check') %><%= lessons.reduce((n, l) => n + l.question_count, 0) %> practice questions</span>
        <% if (!course.published) { %><span class="badge amber">Draft — only you can see this</span><% } %>
      </div>
      <% if (course.description) { %>
        <div class="prose" style="margin-bottom:32px"><% course.description.split(/\n{2,}/).forEach(function (p) { %><p><%= p %></p><% }) %></div>
      <% } %>
      <div class="card">
        <div class="card-head"><h2>Curriculum</h2><span class="muted small"><%= lessons.length %> lessons</span></div>
        <ul class="list">
          <% lessons.forEach(function (l, i) { %>
            <li>
              <span class="num"><%= i + 1 %></span>
              <div class="grow"><span class="title"><%= l.title %></span><% if (l.description) { %><span class="sub"><%= l.description.slice(0, 120) %></span><% } %></div>
              <% if (l.question_count) { %><span class="badge plain"><%= l.question_count %> question<%= l.question_count === 1 ? '' : 's' %></span><% } %>
            </li>
          <% }) %>
          <% if (!lessons.length) { %><li class="muted">Lessons are coming soon.</li><% } %>
        </ul>
      </div>
    </div>

    <aside class="sticky">
      <div class="card">
        <div class="cover" style="--c: <%= course.color %>; aspect-ratio: 16/8; border-radius: var(--radius) var(--radius) 0 0"><span class="glyph"><%= initials(course.title) %></span></div>
        <div class="card-body">
          <% if (enrollment) { %>
            <p class="row" style="gap:8px"><%- icon('check', 'chip-check') %><strong>You're enrolled</strong></p>
            <a href="/learn/course/<%= course.id %>" class="btn primary block">Continue learning</a>
          <% } else if (user && user.id === course.teacher_id) { %>
            <p class="muted small">This is your course.</p>
            <a href="/teach/courses/<%= course.id %>" class="btn secondary block">Manage course</a>
          <% } else if (course.published && !user) { %>
            <a href="/signup?next=/courses/<%= course.id %>" class="btn primary block lg">Enroll — it’s free</a>
            <p class="hint" style="text-align:center">Already have an account? <a href="/login?next=/courses/<%= course.id %>">Sign in</a></p>
          <% } else if (course.published) { %>
            <form method="post" action="/courses/<%= course.id %>/enroll">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <% if (tgProvider) { %>
                <div class="field">
                  <span class="label">Get your lessons on</span>
                  <div class="choice-cards">
                    <label class="choice-card"><input type="radio" name="channel" value="whatsapp" checked><strong class="row" style="gap:6px"><%- icon('whatsapp', 'wa-ico') %>WhatsApp</strong><span>A private group</span></label>
                    <label class="choice-card"><input type="radio" name="channel" value="telegram"><strong class="row" style="gap:6px"><%- icon('telegram', 'tg-ico') %>Telegram</strong><span>Chat with our bot</span></label>
                  </div>
                </div>
              <% } else { %><input type="hidden" name="channel" value="whatsapp"><% } %>
              <div data-for-channel="whatsapp">
                <% if (user && !user.phone) { %>
                  <label class="field"><span>Your WhatsApp number</span><input type="tel" name="phone" placeholder="70 123 456" autocomplete="tel"><span class="hint">e.g. 70 123 456, or +country code for numbers outside Lebanon.</span></label>
                <% } else if (user) { %>
                  <p class="hint" style="margin:-6px 0 14px">Lessons will go to <%= user.phone %> · <a href="/profile">change</a></p>
                <% } %>
              </div>
              <div data-for-channel="telegram" hidden>
                <p class="hint" style="margin:-6px 0 14px"><%= user && user.telegram_chat_id ? 'Lessons will go to your connected Telegram' + (user.telegram_username ? ' (@' + user.telegram_username + ')' : '') + '.' : 'After enrolling, tap “Connect Telegram” once to start.' %></p>
              </div>
              <button class="btn primary block lg" type="submit">Enroll — it’s free</button>
            </form>
          <% } %>
          <hr class="divider">
          <div class="small stack" style="--gap:10px">
            <div class="row" style="gap:10px; align-items:flex-start"><%- icon('whatsapp', 'wa-ico') %><span>Lessons arrive in a private WhatsApp group<%= tgProvider ? ' or a Telegram chat — your choice' : '' %>.</span></div>
            <div class="row" style="gap:10px; align-items:flex-start"><%- icon('poll', 'chip-check') %><span>Practice with polls and get feedback instantly.</span></div>
            <div class="row" style="gap:10px; align-items:flex-start"><%- icon('refresh', 'chip-check') %><span>Prefer the web? Watch and answer here — it all stays in sync.</span></div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>
<%- include('partials/foot') %>
